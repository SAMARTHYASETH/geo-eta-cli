{
  "name": "geo-eta-cli",
  "version": "1.0.2",
  "description": "Zero-dependency geospatial Haversine distance calculator, ETA estimator, and interactive terminal CLI",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "bin": {
    "geo-eta": "cli.js",
    "geo-eta-cli": "cli.js"
  },
  "files": [
    "index.js",
    "cli.js",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "start": "node cli.js",
    "test": "node --test"
  },
  "keywords": [
    "geo",
    "haversine",
    "distance",
    "eta",
    "cli",
    "geolocation",
    "coordinates",
    "zero-dependency"
  ],
  "author": "Samarthya",
